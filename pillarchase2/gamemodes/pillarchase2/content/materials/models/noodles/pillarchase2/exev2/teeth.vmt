"VertexlitGeneric"
{
    "$basetexture" "models/noodles/pillarchase2/exev2/teeth_d"
    // Teeth texture has no normal-map VTF; let Source use its vertex normals.
    "$nodecal" "1"
    "$phong" "1"
    "$phongboost"    "1"
    "$phongexponent" "10"
    "$phongfresnelranges"    "[0.1 0.23 0.945]"
    "$phongdisablehalflambert"    "1"
    "$color2" "[0.8 0.8 0.8]"


    "$envmap" "env_cubemap"
    "$envmapfresnel"    "1"

    "$envmaptint"        0
$nocull 1
}